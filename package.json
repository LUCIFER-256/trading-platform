{
  "name": "trading-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "Phase 1 architecture foundation for a multi-market trading platform.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:architecture": "depcruise --validate .dependency-cruiser.cjs apps packages",
    "check:migration-immutability": "node scripts/check-migration-immutability.cjs",
    "migrate:up": "npm run build && node dist/apps/api/src/migrate.js",
    "auth:issue-password-reset": "npm run build && node dist/apps/api/src/issue-password-reset.js",
    "auth:bootstrap-super-admin": "npm run build && node dist/apps/api/src/bootstrap-super-admin.js",
    "api:serve": "npm run build && node dist/apps/api/src/http-server.js",
    "test": "npm run build && node scripts/run-unit-tests.cjs",
    "test:database-integration": "npm run build && node dist/tests/integration/database-health.integration.test.js",
    "test:migrations-integration": "npm run build && node dist/tests/integration/migrations.integration.test.js",
    "test:http-integration": "npm run build && node dist/tests/integration/http.integration.test.js",
    "test:market-data-integration": "npm run build && node dist/tests/integration/market-data-functions.integration.test.js",
    "test:market-data-privileges-integration": "npm run build && node dist/tests/integration/market-data-privileges.integration.test.js",
    "test:market-data-persistence-integration": "npm run build && npm run test:market-data-persistence-integration:run",
    "test:market-data-persistence-integration:run": "node dist/tests/integration/market-data-persistence-port.integration.test.js",
    "test:market-data-startup-integration": "npm run build && node dist/tests/integration/market-data-startup.integration.test.js",
    "test:market-data-engine-integration": "npm run build && node dist/tests/integration/market-data-engine.integration.test.js",
    "test:market-data-gates-integration": "npm run build && node dist/tests/integration/market-data-gates.integration.test.js",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "test:wire": "npm run build && node dist/tests/unit/market-data-wire.test.js"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "8.18.2",
    "dependency-cruiser": "16.10.0",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "ws": "8.22.0"
  }
}
