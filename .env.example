# Never commit real credentials. Sprint 2.2 creates the pool only inside the
# server-side database package; it does not create schemas or run migrations.
# TRADING_MODE=development
# DATABASE_URL=postgresql://user:password@localhost:5432/trading_platform
# TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5432/trading_platform_test
# DATABASE_SSL_MODE=disable
# DATABASE_SSL_CA_PATH=/absolute/path/to/ca.pem
# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT_MS=5000
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# DATABASE_LOCK_TIMEOUT_MS=5000
# DATABASE_TRANSACTION_TIMEOUT_MS=30000
# DATABASE_APPLICATION_NAME=trading-platform
